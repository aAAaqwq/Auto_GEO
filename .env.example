# JWT认证密钥（必需）
JWT_SECRET_KEY=your-secret-key-here

# 数据库配置
DATABASE_URL=sqlite:///./data/autogeo.db

# API配置
API_PORT=8000

# AI structured extraction config
# Prefer GLM when GLM_API_KEY is set. Fallback to DeepSeek, then regex.
GLM_API_KEY=
GLM_API_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash-250414

DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# AutoGEO backend Agent LLM config
# Set these to enable structured natural-language parsing in the backend Agent.
AUTOGEO_CONVERSATION_USE_LLM=false
AUTOGEO_CONVERSATION_LLM_PROVIDER=deepseek
AUTOGEO_CONVERSATION_LLM_MODEL=deepseek v4-pro
AUTOGEO_CONVERSATION_LLM_API_KEY=
AUTOGEO_CONVERSATION_LLM_BASE_URL=https://api.deepseek.com/v1

# RAGFlow config
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=
# RAGFlow dataset embedding model. Must be available for the same RAGFlow tenant as RAGFLOW_API_KEY.
RAGFLOW_EMBEDDING_MODEL=text-embedding-v4@Tongyi-Qianwen

# Feishu Bot config
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_BOT_NAME=AutoGeo助手
